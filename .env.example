# ─── تنظیمات سرور لیستیا (Node.js) ──────────────────────────────────────────
# پورت API (در توسعه از طریق پروکسی Vite در دسترس است)
PORT=3001

# راز نشست‌ها و امضاها — در تولید اجباری است؛ یک راز تصادفی قوی بگذارید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=

# راز سامانه‌ی لایسنس — در تولید اجباری است و باید راز جدید مخصوص خودتان باشد.
# (هیچ راز واقعی‌ای نباید داخل مخزن باشد)
LICENSE_SECRET=
# اگر راز را عوض کرده‌اید ولی باید کلیدهای قدیمی همچنان تأیید شوند، رازهای قبلی
# را با کاما اینجا بگذارید (فقط برای تأیید؛ کلید جدید با راز جدید ساخته می‌شود):
# LICENSE_SECRET_LEGACY=

# نام‌های کاربری رزروشده‌ی مدیر (با کاما جدا کنید)
ADMIN_USERNAMES=smq2458,admin

# ساخت خودکار مدیر اول در اجرای اول (0 = خاموش)
ADMIN_AUTOBOOT=1
ADMIN_USERNAME=admin
# در تولید بدون این متغیر، ساخت ادمین خودکار متوقف می‌شود؛ رمز قوی بگذارید
ADMIN_PASSWORD=

# کلید ساخت حساب با نام رزروشده در ثبت‌نام
# ADMIN_SETUP_TOKEN=

# ─── SMTP برای ارسال کد تأیید ایمیل ────────────────────────────────────────
# اگر خالی باشد، فقط در حالت توسعه (NODE_ENV≠production) کد در پاسخ API و
# کنسول نمایش داده می‌شود؛ در production بدون این متغیرها کدی ارسال نمی‌شود.
#
# پورت ۴۶۵ = اتصال SSL از ابتدا  (SMTP_USE_SSL=1)
# پورت ۵۸۷ = STARTTLS           (SMTP_USE_SSL=0 یا خالی) ← پیشنهاد رایج
# SMTP_HOST=mail.example.ir
# SMTP_PORT=587
# SMTP_USERNAME=no-reply@example.ir
# SMTP_PASSWORD=رمز همان صندوق ایمیل
# SMTP_FROM=no-reply@example.ir
# SMTP_FROM_NAME=لیستیا
# SMTP_REPLY_TO=no-reply@example.ir
# SMTP_USE_SSL=0
# فقط اگر سرور ایمیل گواهی self-signed دارد (معمولاً لازم نیست):
# SMTP_TLS_INSECURE=0
# سقف زمان کل ارسال هر ایمیل به میلی‌ثانیه (پیش‌فرض ۲۰۰۰۰):
# SMTP_TIMEOUT_MS=20000
#
# تست زنده‌ی تنظیمات ایمیل روی سرور:
#   node server/mail-test.mjs                  (ارسال به خود حساب SMTP)
#   node server/mail-test.mjs kasi@example.com

# برای اجرای محلی روی http (بدون HTTPS) بگذارید 1 تا کوکی نشست کار کند
# COOKIE_INSECURE=0

# ─── پشتیبانی هوش مصنوعی (سرویس AI چابکان) ────────────────────────────────
# درگاه با OpenAI سازگار است؛ کلید را از پنل چابکان ← سرویس هوش مصنوعی بسازید.
# کلید فقط سمت سرور می‌ماند و هیچ‌گاه به مرورگر ارسال نمی‌شود.
# CHABOKAN_AI_API_KEY=sk-chbk-کلید-واقعی-شما
# مدل پیش‌فرض chabok/free (مدل رایگان رسمی چابکان) است؛
# openai/gpt-oss-20b-free (تقریباً رایگان، فارسی خوب) خودکار به‌عنوان پشتیبان تنظیم شده است.
# CHABOKAN_AI_MODEL=chabok/free
# CHABOKAN_AI_MODEL_FALLBACK=openai/gpt-oss-20b-free
# (یا چند مدل با کاما در CHABOKAN_AI_MODELS)
# CHABOKAN_AI_BASE_URL=https://ai.chabokan.net/v1
# مدل «جستجوی قیمت» در صفحه‌ی برآورد: مدلی که به اینترنت دسترسی دارد و
# قیمت‌های زنده را خودش از سایت‌ها پیدا می‌کند (جدا از مدل پشتیبانی).
# CHABOKAN_AI_PRICE_MODEL=dots-studio/dots-3-note-preview:free
# سقف زمان هر پاسخ (میلی‌ثانیه) و دمای پاسخ (پایین = دقیق‌تر):
# CHABOKAN_AI_TIMEOUT_MS=30000
# CHABOKAN_AI_TEMPERATURE=0.3
