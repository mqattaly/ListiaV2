# ─── تنظیمات سرور لیستیا (Node.js) ──────────────────────────────────────────
# پورت API (در توسعه از طریق پروکسی Vite در دسترس است)
PORT=3001

# راز نشست‌ها و امضاها (در تولید حتماً ست کنید)
SECRET_KEY=change-me-in-production

# راز سامانه‌ی لایسنس — با نسخه‌ی پایتون یکسان است تا کلیدها سازگار بمانند
LICENSE_SECRET=LISTIA-GHATTALI-LICENSE-SECURE-KEY-2026

# نام‌های کاربری رزروشده‌ی مدیر (با کاما جدا کنید)
ADMIN_USERNAMES=smq2458,admin

# ساخت خودکار مدیر اول در اجرای اول (0 = خاموش)
ADMIN_AUTOBOOT=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# کلید ساخت حساب با نام رزروشده در ثبت‌نام
# ADMIN_SETUP_TOKEN=

# SMTP برای ارسال کد تأیید ایمیل (اگر خالی باشد، حالت توسعه فعال می‌شود
# و کد در پاسخ API و کنسول سرور نمایش داده می‌شود)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# برای اجرای محلی روی http (بدون HTTPS) بگذارید 1 تا کوکی نشست کار کند
# COOKIE_INSECURE=0
